{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.paulgosnell/accountsos-mcp",
  "title": "AccountsOS",
  "description": "Query your live AccountsOS books: balances, transactions, VAT, deadlines, invoices.",
  "websiteUrl": "https://accounts-os.com",
  "repository": {
    "url": "https://github.com/thriveventurelabs/accountsos-mcp-server",
    "source": "github"
  },
  "version": "0.3.2",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/thriveventurelabs/accountsos-agent-plugin/main/assets/logo.png",
      "mimeType": "image/png"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@thriveventurelabs/accountsos-mcp",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your AccountsOS API key (from https://accounts-os.com/settings)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "ACCOUNTSOS_API_KEY"
        },
        {
          "description": "Override API base URL (default https://accounts-os.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "ACCOUNTSOS_BASE_URL"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://accounts-os.com/api/mcp/plugin"
    }
  ]
}
